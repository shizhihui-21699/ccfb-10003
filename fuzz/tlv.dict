# libFuzzer dictionary for TLVX. Header magic, version and every length-prefix
# discriminator, so mutations start from syntactically interesting bytes.
magic="TLVX"
version="\x01"
byte_strict_flag="\x00\x01"
len_1byte_max="\x7f"
len_2byte_min="\x80\x00"
len_2byte_max="\x9f\xff"
len_3byte_min="\xc0\x00\x00"
len_3byte_max="\xcf\xff\xff"
len_ext_prefix="\xe0"
len_reserved_1="\xd0"
len_reserved_2="\xf0"
type_int="\x00"
type_uint="\x10"
type_bytes="\x20"
type_string="\x30"
type_bool="\x40"
type_container="\xd0"
type_skip="\x60"
type_opt_slot0="\x08"
type_opt_slot7="\x0f"
varint_cont="\x80"
varint_max="\xff\xff\xff\xff\xff\xff\xff\x7f"
bool_true="\x01"
bool_false="\x00"
